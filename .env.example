# Copy file này thành `.env` rồi điền giá trị thật. `.env` đã được gitignore.
# `scripts/redmine_fetch.py` đọc thẳng file `.env` này — KHÔNG cần export env vào
# shell trước khi mở Claude Code (xem docs/REDMINE-SETUP.md).

# Redmine REST API (xem docs/REDMINE-SETUP.md)
# URL = BASE URL của Redmine (không kèm /projects/.../issues path).
REDMINE_URL=https://redmine.example.com
REDMINE_API_KEY=your-api-key-here

# (Tùy chọn) Đặt 0 nếu Redmine nội bộ dùng self-signed cert và bị lỗi SSL.
# REDMINE_VERIFY_SSL=1
